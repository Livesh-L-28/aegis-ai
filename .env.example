# ==============================================================================
# AEGIS AI Production / Local Deployment Configuration
# ==============================================================================

# Core Application
ENVIRONMENT=production
APP_NAME="AEGIS AI"
APP_VERSION=0.1.0
LOG_LEVEL=INFO
DEBUG=false

# Host Port Mappings (Configurable to prevent host port collisions)
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
GATEWAY_PORT=8080
USER_SERVICE_PORT=8001
PAYMENT_SERVICE_PORT=8002

# PostgreSQL Database with pgvector
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=aegis
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/aegis
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis (Caching, Ephemeral locks, Rate limits)
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# Object Storage (S3-compatible MinIO)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=aegis-data
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadminpassword
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false

# Observability (Prometheus, Grafana, Loki)
GRAFANA_ADMIN_PASSWORD=admin
OTEL_ENDPOINT=http://localhost:4317
OTEL_ENABLED=false
OTEL_SERVICE_NAME=aegis-api

# Security & Identity Provider Boundary
JWT_ISSUER=https://auth.aegis.ai
JWT_AUDIENCE=aegis-api
DEV_AUTH_ENABLED=true

# Security Middlewares & Headers
# In production, provide your deployed frontend origins (e.g. comma-separated or JSON list)
CORS_ALLOWED_ORIGINS="https://aegis-ai.vercel.app,http://localhost:5173,http://localhost:3000"
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0,aegis-api,*.onrender.com,*.vercel.app,testserver,*"
MAX_REQUEST_SIZE_BYTES=10485760

# ==============================================================================
# Frontend Environment Variables (apps/web)
# ==============================================================================
# VITE_API_BASE_URL=https://aegis-ai-api.onrender.com
