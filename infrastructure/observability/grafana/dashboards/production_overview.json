{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Service Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Service Error Rate (status 5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[1m])) by (service)",
          "legendFormat": "{{service}} 5xx"
        }
      ]
    },
    {
      "title": "Database Query Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(database_query_duration_seconds_bucket[1m])) by (le, service))",
          "legendFormat": "p95 DB Latency: {{service}}"
        }
      ]
    },
    {
      "title": "Redis Errors Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(redis_errors_total[1m])) by (service, command)",
          "legendFormat": "Redis Error: {{service}} ({{command}})"
        }
      ]
    },
    {
      "title": "Business: Orders Created vs Failed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(orders_created_total[1m]))",
          "legendFormat": "Orders Created"
        },
        {
          "expr": "sum(rate(orders_failed_total[1m]))",
          "legendFormat": "Orders Failed"
        }
      ]
    },
    {
      "title": "Business: Payments Attempted vs Failed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(payments_attempted_total[1m]))",
          "legendFormat": "Payments Attempted"
        },
        {
          "expr": "sum(rate(payments_failed_total[1m]))",
          "legendFormat": "Payments Failed"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["aegis", "production-sim", "observability"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
